{
  "project": "tmaback",
  "version": "1.0.0",
  "docs_url": "https://tmaback.vercel.app/docs/",
  "modules": [
    "Dramabox Integration (go-v2 logic)",
    "Telegram Bot (grammY)",
    "Authentication (TMA InitData + JWT)",
    "User Statistics & History",
    "Favorites & Metadata",
    "Subscriptions & Payments"
  ],
  "infrastructure": {
    "runtime": "Node.js (TypeScript)",
    "framework": "Express",
    "database": "MongoDB Atlas",
    "cache": "Upstash Redis",
    "security": "RSA-SHA256 Signing + Axios TLS + GZIP support"
  },
  "endpoints": [
    {
      "path": "/auth/telegram",
      "method": "POST",
      "description": "Exchange Telegram Mini App initDataRaw for JWT",
      "body": ["initDataRaw"]
    },
    {
      "path": "/users/me",
      "method": "GET",
      "auth": true,
      "description": "Get current user profile and subscription"
    },
    {
      "path": "/users/stats",
      "method": "GET",
      "auth": true,
      "description": "Get watch statistics and Continue Watching list"
    },
    {
      "path": "/favorites/toggle",
      "method": "POST",
      "auth": true,
      "description": "Add or remove a series from favorites",
      "body": ["series_id"]
    },
    {
      "path": "/favorites",
      "method": "GET",
      "auth": true,
      "description": "Get all favorited series with metadata"
    },
    {
      "path": "/subscription/upgrade",
      "method": "POST",
      "auth": true,
      "description": "Upgrade user to VIP plan",
      "body": ["plan_type (weekly, monthly, yearly)"]
    },
    {
      "path": "/payments/create",
      "method": "POST",
      "auth": true,
      "description": "Create a new payment record"
    },
    {
      "path": "/watch/home",
      "method": "GET",
      "description": "Fetch categorized homepage sections",
      "query": ["lang"]
    },
    {
      "path": "/watch/foryou",
      "method": "GET",
      "description": "Fetch specialized recommendations",
      "query": ["lang", "page", "video (optional true/false)"]
    },
    {
      "path": "/watch/search",
      "method": "GET",
      "description": "Search for dramas",
      "query": ["q", "page", "lang"]
    },
    {
      "path": "/watch/stream/:id/:episode",
      "method": "GET",
      "auth": true,
      "description": "Fetch streaming links with Unlock Bypass and Quality/Episode capping",
      "params": ["id", "episode"],
      "logic": {
        "free_limits": {
          "episode_cap": "10-25% of total (clamped 5-30)",
          "quality_lock": ["1080p"]
        }
      }
    }
  ],
  "telegram_bot": {
    "commands": [
      {
        "command": "/start",
        "payload": "series_id (optional)",
        "description": "Launch Mini App. Supports startapp payload for deep linking."
      }
    ],
    "features": [
      {
        "type": "inline_query",
        "description": "Global search for dramas with rich HTML cards and deep-linked play buttons.",
        "cache_time": 300
      }
    ]
  }
}
